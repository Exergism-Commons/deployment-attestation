{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deployment-attestation.exergism.org/spec/release-manifest-v0.1.schema.json",
  "title": "Exergism Commons Deployment Release Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "release_tag",
    "source_commit",
    "generated_at",
    "assets"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "release_tag": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "assets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
