# Copy to /etc/ec-deployment-attestation/id.exergism.org.env
# Keep this file root-owned (0640 or stricter). Do not commit real secrets.

EC_SERVICE=id.exergism.org
EC_REPOSITORY=Exergism-Commons/id
EC_ENVIRONMENT=production
EC_RELEASE_TAG=runtime-main
EC_RELEASE_ASSET_PATTERN=idresolver-linux-{arch}

EC_APP_DIR=/srv/id.exergism.org
EC_APP_BIN=/usr/local/bin/idresolver
EC_SERVICE_UNIT=id-exergism
EC_SOURCE_REVISION_FILE=/usr/local/share/doc/idresolver/source-revision.txt

EC_LOCAL_URL=http://127.0.0.1:8080/
EC_PUBLIC_URL=https://id.exergism.org/
EC_CHECK_PUBLIC=1
EC_SMOKE_SCRIPT=/usr/local/libexec/id.exergism.org-smoke.sh

# Enable only after the receiver exists.
# EC_ATTESTATION_ENDPOINT=https://health.exergism.org/v1/attest
# EC_HMAC_SECRET_FILE=/etc/ec-deployment-attestation/secrets/id.exergism.org.hmac

# Optional stable host identifier. Defaults to hostname -f.
# EC_HOST_ID=id-prod-01
